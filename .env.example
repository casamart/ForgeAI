# ---------------------------------------------------------------------------
# ForgeAI environment configuration
# Copy to `.env` and fill in. Every value is optional for the local mock mode.
# ---------------------------------------------------------------------------

# --- Solari (cloud sandboxes + browsers) -----------------------------------
# Get one key from https://console.getsolari.com (looks like slr_live_...).
# When set, ForgeAI runs against real Solari infrastructure.
SOLARI_API_KEY=

# Infrastructure mode: "solari" | "local" | "auto" (default).
# "auto" uses Solari when SOLARI_API_KEY is present, otherwise the local mock.
FORGEAI_MODE=auto

# --- AI providers (agents) --------------------------------------------------
# Pick which provider powers the agents: "anthropic" | "openai" | "gemini" | "mock"
FORGEAI_AI_PROVIDER=mock

# Provider API keys (only the selected provider's key is required).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional model overrides (sensible defaults are baked in per provider).
ANTHROPIC_MODEL=
OPENAI_MODEL=
GEMINI_MODEL=

# --- Resource limits (cost control, spec §28.3) -----------------------------
MAX_BUILD_TIME_MS=600000
MAX_DEBUG_LOOPS=3
MAX_REPAIR_ATTEMPTS=3
MAX_BROWSER_SESSIONS=1
